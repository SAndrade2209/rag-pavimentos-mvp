' Styled single view of the C3 components of the API application, to see all components at once.
' Large: for reading on screen. The three focused views stay the main C3 diagrams.
' It combines the three views in ../c3-components.puml (requests and access; loading and data
' layers; question answering): same elements and relationships as the three views together.
' The three views stay the reference. When one of them changes, update this view too.
' Step labels: L1 to L11 follow a load (view 2); Q1 to Q8 follow a question (view 3).

@startuml c3-all-components
!include <C4/C4_Component>
!include style.puml
' Curved lines: with right-angle lines, Graphviz puts labels on top of boxes.
skinparam linetype splines

title API application: all components (C3, single view)
caption L1 to L11 follow a load (view 2); Q1 to Q8 follow a question (view 3). Pink arrows show a correction (UC-09). Dotted arrows show the scheduled retention job.\nBronze, silver and gold are schemas of the platform database, all under row-level security.

Container(web, "Web application", "", "Sends every request", $sprite="desktop", $tags="web")
System_Ext(idp, "Identity service", "Issues sign-in tokens", $sprite="key", $tags="external")
System_Ext(pms, "Client pavement management system", "Funding agency only", $sprite="database", $tags="external")
ContainerDb(files, "File storage", "", "Original files, kept for a retention period", $sprite="archive", $tags="files")
Container(llm, "Language model", "", "No database access. Never receives result rows.", $sprite="brain", $tags="model")

Boundary(api, "API application") {
  Boundary(m_access, "Access module") {
    Component(guard, "Access guard", "", "Checks the sign-in token; loads user, client and permissions; sets the client for row-level security. Denies by default.", $sprite="shield_alt", $tags="access")
    Component(access_mgmt, "Access management", "", "Grants and removes project access and permissions", $sprite="user_lock", $tags="access")
  }
  Boundary(m_projects, "Projects module") {
    Component(projects, "Projects", "", "Project list and workspace, granted projects only", $sprite="folder_open", $tags="projects")
  }
  Boundary(m_views, "Views module") {
    Component(views, "Project and section views", "", "Latest PCI by section; PCI by survey year and survey timeline", $sprite="chart_line", $tags="views")
  }
  Boundary(m_loading, "Loading module") {
    Component(jobs, "Load jobs", "", "Background jobs in the same process. Running a load again does not duplicate rows.", $sprite="tasks", $tags="loading")
    Component(adapters, "Input adapters", "CSV, Excel, agency connection", "Read each source with the client's saved column mapping", $sprite="file_import", $tags="loading")
    Component(validation, "Validation and load summary", "", "UC-05 checks. Rows added, conflicts, and rejected rows with the reason.", $sprite="clipboard_check", $tags="loading")
    Component(retention, "Retention job", "", "Scheduled. Deletes expired original files and answer log entries.", $sprite="trash_alt", $tags="loading")
  }
  Boundary(m_pci, "PCI data module") {
    Component(corrections, "Corrections", "", "New versions with who, when and why. Resolves load conflicts.", $sprite="edit", $tags="pci")
    Component(gold_refresh, "Gold refresh", "", "Rebuilds the client's gold tables in the same transaction as the load or correction", $sprite="sync_alt", $tags="pci")
  }
  Boundary(m_qa, "Question answering module") {
    Component(planner, "Query planner", "", "Gets a query plan from the model and validates it", $sprite="sitemap", $tags="qa")
    Component(judge, "Judge", "", "Checks that the plan answers the question. If not, the planner builds a new plan, up to 3 in total.", $sprite="gavel", $tags="qa")
    Component(query_builder, "Query builder", "", "Parameterized, read-only query on gold", $sprite="filter", $tags="qa")
    Component(answer_writer, "Answer writer", "", "Writes the answer from a template; keeps the model's reword only if the figures match", $sprite="file_alt", $tags="qa")
    Component(llm_port, "Language model interface", "", "The only way to reach the model. One adapter per model option.", $sprite="plug", $tags="qa")
  }
  Boundary(m_audit, "Audit module") {
    Component(audit, "Audit log", "", "PCI data changes, access grants and removals, denied requests, load summaries, answer log", $sprite="clipboard_list", $tags="audit")
  }
}

Boundary(db, "Platform database: row-level security on every schema") {
  ComponentDb(platform_tables, "Platform tables", "", "Users, clients, projects, permissions, load jobs, audit log", $sprite="table", $tags="tables")
  ComponentDb(bronze, "Bronze schema", "", "Every load as received, with who, when and source. Never changed.", $sprite="database", $tags="bronze")
  ComponentDb(silver, "Silver schema", "", "Validated PCI per section and survey year. Versions with who, when and why. Conflicts.", $sprite="database", $tags="silver")
  ComponentDb(gold, "Gold schema", "", "Latest PCI per section, PCI by survey year, project overview, network summaries", $sprite="database", $tags="gold")
}

' Layout only: hidden links that steer the Graphviz layout (PCI data module beside the loading
' module, identity service near the access guard). They do not fix the exact order of the boxes.
Lay_R(validation, gold_refresh)
Lay_R(bronze, silver)
Lay_R(silver, gold)
Lay_R(gold, platform_tables)

' Requests and access (view 1).
Rel(web, guard, "Every request", "JSON over HTTPS")
Rel(guard, idp, "Checks sign-in tokens", "OpenID Connect")
Rel(guard, platform_tables, "Users, clients, permissions; sets the client")
Rel(guard, access_mgmt, "UC-08")
Rel(guard, projects, "UC-06, UC-07")
Rel(guard, views, "UC-06")
Rel(guard, audit, "Denied requests")
Rel(access_mgmt, platform_tables, "Writes access and permissions")
Rel(access_mgmt, audit, "Grants and removals")
Rel(projects, platform_tables, "Reads projects")
Rel(views, gold, "Reads")
Rel(audit, platform_tables, "Writes audit records")

' Loading and data layers (view 2).
Rel(guard, jobs, "L1  Load request", "UC-05")
Rel(jobs, adapters, "L2  Runs the load")
Rel(adapters, files, "L3  Upload: stores the original file")
Rel(adapters, pms, "L3  Agency connection", "Method pending", $tags="pending")
Rel(adapters, bronze, "L4  Raw rows with the load record")
Rel(jobs, validation, "L5  Validates the load")
Rel(validation, bronze, "L6  Reads raw rows")
Rel(validation, silver, "L7  Validated PCI; conflicts")
Rel(validation, gold_refresh, "L8  Refresh")
Rel(gold_refresh, silver, "L9  Reads current versions")
Rel(gold_refresh, gold, "L10  Rebuilds serving tables")
Rel(validation, audit, "L11  Load summary")

Rel(guard, corrections, "Correction request", "UC-09", $tags="correction")
Rel(corrections, silver, "New version; resolves conflicts", $tags="correction")
Rel(corrections, gold_refresh, "Refresh", $tags="correction")
Rel(corrections, audit, "Who, when and why", $tags="correction")

Rel(retention, files, "Deletes expired files", $tags="retention")
Rel(retention, audit, "Asks to delete expired answer log entries", $tags="retention")

' Question answering (view 3).
Rel(guard, planner, "Q1  Checked question", "UC-01 to UC-04")
Rel(planner, llm_port, "Q2  Build a plan")
Rel(planner, judge, "Q3  Check the plan")
Rel(judge, llm_port, "Q4  Verdict")
Rel(planner, query_builder, "Q5  Accepted plan")
Rel(query_builder, gold, "Q6  Read-only query")
Rel(query_builder, answer_writer, "Q7  Query and results")
Rel(answer_writer, llm_port, "Q8  Reword the template text")
Rel(llm_port, llm, "Calls the model", "HTTPS")
Rel(planner, audit, "Question, plans, verdicts")
Rel(answer_writer, audit, "Query, results, texts")

SHOW_LEGEND()
@enduml
